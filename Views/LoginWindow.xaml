<Window x:Class="TipaDiplom.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Дискретная математика" 
        Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Grid>
        <Border Background="#181825" CornerRadius="15" Margin="20" Padding="30">
            <StackPanel VerticalAlignment="Center">

                <!-- Логотип -->
                <TextBlock Text="📐" FontSize="50" HorizontalAlignment="Center" 
                           Margin="0,0,0,5"/>
                <TextBlock Text="Дискретная математика" FontSize="22" FontWeight="Bold"
                           Foreground="#CBA6F7" HorizontalAlignment="Center" 
                           Margin="0,0,0,5"/>
                <TextBlock Text="Войдите в систему" FontSize="14"
                           Foreground="#6C7086" HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <!-- Имя пользователя -->
                <TextBlock Text="Имя пользователя или Email" Foreground="#BAC2DE" 
                           FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" FontSize="14" Padding="10,8"
                         Background="#313244" Foreground="#CDD6F4" 
                         BorderBrush="#45475A" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Foreground="#BAC2DE" FontSize="13" 
                           Margin="0,15,0,5"/>
                <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8"
                             Background="#313244" Foreground="#CDD6F4" 
                             BorderBrush="#45475A" BorderThickness="1">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Сообщение об ошибке -->
                <TextBlock x:Name="ErrorMessage" Text="" Foreground="#F38BA8" 
                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="Collapsed"/>

                <!-- Кнопка входа -->
                <Button Content="Войти" FontSize="16" FontWeight="Bold"
                        Padding="0,12" Margin="0,20,0,10"
                        Background="#CBA6F7" Foreground="#1E1E2E"
                        BorderThickness="0" Cursor="Hand"
                        Click="Login_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Ссылка на регистрацию -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Нет аккаунта? " Foreground="#6C7086" FontSize="13"/>
                    <TextBlock Text="Зарегистрируйтесь" Foreground="#89B4FA" FontSize="13"
                               Cursor="Hand" TextDecorations="Underline"
                               MouseLeftButtonDown="GoToRegister_Click"/>
                </StackPanel>

                <!-- Статус подключения -->
                <TextBlock x:Name="ConnectionStatus" Text="" FontSize="11"
                           Foreground="#6C7086" HorizontalAlignment="Center" 
                           Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>