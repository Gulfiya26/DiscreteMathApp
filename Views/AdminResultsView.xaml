<UserControl x:Class="TipaDiplom.Views.AdminResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📊 Результаты студентов" FontSize="24"
                       FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock x:Name="CountText" Text="Загрузка..."
                       Foreground="#6C7086" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Фильтры -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterUserBox" Grid.Column="0"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderBrush="#45475A" Padding="8,6" FontSize="13"
                     Margin="0,0,5,0"
                     Text="Поиск по студенту..."
                     GotFocus="FilterBox_GotFocus"/>

            <ComboBox x:Name="FilterCategoryBox" Grid.Column="1"
                      Background="#313244" Foreground="#CDD6F4"
                      BorderBrush="#45475A" Padding="8,6" FontSize="13"
                      Margin="0,0,5,0">
                <ComboBoxItem Content="Все модули" IsSelected="True"/>
                <ComboBoxItem Content="Тестирование"/>
                <ComboBoxItem Content="Теория множеств"/>
                <ComboBoxItem Content="Булева алгебра"/>
                <ComboBoxItem Content="Теория графов"/>
                <ComboBoxItem Content="Комбинаторика"/>
                <ComboBoxItem Content="Матрицы"/>
                <ComboBoxItem Content="Системы счисления"/>
            </ComboBox>

            <Button Grid.Column="2" Content="🔍 Найти"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    Padding="15,6" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand" Margin="0,0,5,0"
                    Click="Search_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="3" Content="🔄 Обновить"
                    Background="#A6E3A1" Foreground="#1E1E2E"
                    Padding="15,6" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"
                    Click="Refresh_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Таблица результатов -->
        <Border Grid.Row="2" Background="#313244" CornerRadius="8">
            <DataGrid x:Name="ResultsGrid"
                      Background="Transparent"
                      Foreground="#CDD6F4"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#45475A"
                      RowBackground="#313244"
                      AlternatingRowBackground="#2A2A3E"
                      ColumnHeaderHeight="40"
                      RowHeight="35"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      FontSize="13">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#45475A"/>
                        <Setter Property="Foreground" Value="#CBA6F7"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Студент" 
                                        Binding="{Binding DisplayName}" 
                                        Width="130"/>
                    <DataGridTextColumn Header="Логин" 
                                        Binding="{Binding Username}" 
                                        Width="100"/>
                    <DataGridTextColumn Header="Модуль" 
                                        Binding="{Binding ModuleName}" 
                                        Width="120"/>
                    <DataGridTextColumn Header="Задание" 
                                        Binding="{Binding TaskDescription}" 
                                        Width="200"/>
                    <DataGridTextColumn Header="Результат" 
                                        Binding="{Binding Result}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Дата" 
                                        Binding="{Binding CreatedAt, 
                                        StringFormat=dd.MM.yyyy HH:mm}" 
                                        Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    Margin="0,10,0,0">
            <Button Content="🗑️ Удалить выбранное"
                    Background="#F38BA8" Foreground="#1E1E2E"
                    Padding="15,8" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"
                    Click="DeleteResult_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>