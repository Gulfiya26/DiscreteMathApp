<UserControl x:Class="TipaDiplom.Views.BooleanAlgebraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F9E2AF"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="⚡ Булева алгебра" FontSize="24" FontWeight="Bold" 
                       Foreground="#F9E2AF" Margin="0,0,0,15"/>

            <TextBlock Foreground="#BAC2DE" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                <Run Text="Операции: &amp; или * (И), | или + (ИЛИ), ! или ¬ (НЕ), ^ или ⊕ (XOR), -> (импликация)"/>
                <LineBreak/>
                <Run Text="Переменные: любые буквы (a, b, c, x, y...)"/>
            </TextBlock>

            <TextBlock Text="Переменные (через запятую):" Foreground="#CDD6F4" 
                       FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="VariablesInput" Text="a, b, c"/>

            <TextBlock Text="Логическое выражение:" Foreground="#CDD6F4" 
                       FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="ExpressionInput" Text="(a | b) &amp; !c"/>

            <WrapPanel Margin="0,15,0,10">
                <Button Content="Таблица истинности" Click="TruthTable_Click"/>
                <Button Content="СДНФ" Click="SDNF_Click"/>
                <Button Content="СКНФ" Click="SKNF_Click"/>
                <Button Content="Полином Жегалкина" Click="Zhegalkin_Click"/>
                <Button Content="Свойства (Пост)" Click="PostProperties_Click"/>
                <Button Content="Полный анализ" Click="FullAnalysis_Click" 
                        Background="#A6E3A1"/>
            </WrapPanel>

            <Border Background="#313244" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                <TextBlock x:Name="ResultText" Text="Результат появится здесь..." 
                           Foreground="#A6E3A1" FontSize="13" TextWrapping="Wrap"
                           FontFamily="Consolas"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>