<UserControl x:Class="TipaDiplom.Views.AddTheoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список лекций -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="📚 Лекции"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#F9E2AF" Margin="0,0,0,10"/>

            <ListBox x:Name="LectureList" Grid.Row="1"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="0" FontSize="13"
                     SelectionChanged="LectureList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,3">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="#CDD6F4" TextWrapping="Wrap"/>
                            <TextBlock FontSize="11" Foreground="#6C7086">
                                <Run Text="Создана: "/>
                                <Run Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="➕ Новая" Padding="12,6"
                        Background="#A6E3A1" Foreground="#1E1E2E"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,5,0"
                        Click="NewLecture_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="🗑️ Удалить" Padding="12,6"
                        Background="#F38BA8" Foreground="#1E1E2E"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"
                        Click="DeleteLecture_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Редактор лекции -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="✏️ Редактор лекции"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#F9E2AF" Margin="0,0,0,15"/>

            <!-- Номер лекции -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Номер лекции:" Foreground="#CDD6F4"
                           FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="NumberBox" Padding="8,6" FontSize="14"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1"
                         Width="100" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Название темы -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Название темы:" Foreground="#CDD6F4"
                           FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="TitleBox" Padding="8,6" FontSize="14"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1"/>
            </StackPanel>

            <!-- Содержимое -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Содержимое лекции:" Foreground="#CDD6F4"
                           FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="ContentBox"
                         Height="300"
                         Padding="10" FontSize="13"
                         FontFamily="Consolas"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Статус -->
            <TextBlock x:Name="StatusText" Grid.Row="4"
                       Text="" FontSize="13" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>

            <!-- Кнопки сохранения -->
            <StackPanel Grid.Row="5" Orientation="Horizontal">
                <Button Content="💾 Сохранить" Padding="20,10"
                        Background="#89B4FA" Foreground="#1E1E2E"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="14" FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        Click="SaveLecture_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="🔄 Очистить" Padding="20,10"
                        Background="#45475A" Foreground="#CDD6F4"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="14" FontWeight="SemiBold"
                        Click="ClearForm_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>