<UserControl x:Class="TipaDiplom.Views.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <!-- Экран выбора теста -->
        <Border x:Name="SelectionPanel" Background="Transparent" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="📝 Тестирование" FontSize="24" FontWeight="Bold"
                               Foreground="#F5C2E7" Margin="0,0,0,5"/>
                    <TextBlock Text="Выберите тему и количество вопросов" FontSize="14"
                               Foreground="#6C7086" Margin="0,0,0,20"/>

                    <!-- Выбор темы -->
                    <TextBlock Text="Тема:" Foreground="#CDD6F4" FontSize="14" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CategoryCombo" FontSize="14" Padding="8,6"
                              Background="#313244" Foreground="#CDD6F4"
                              BorderBrush="#45475A" SelectedIndex="6">
                        <ComboBoxItem Content="Теория множеств"/>
                        <ComboBoxItem Content="Булева алгебра"/>
                        <ComboBoxItem Content="Теория графов"/>
                        <ComboBoxItem Content="Комбинаторика"/>
                        <ComboBoxItem Content="Системы счисления"/>
                        <ComboBoxItem Content="Матрицы и отношения"/>
                        <ComboBoxItem Content="Все темы"/>
                    </ComboBox>

                    <!-- Количество вопросов -->
                    <TextBlock Text="Количество вопросов:" Foreground="#CDD6F4"
                               FontSize="14" Margin="0,15,0,5"/>
                    <ComboBox x:Name="QuestionCountCombo" FontSize="14" Padding="8,6"
                              Background="#313244" Foreground="#CDD6F4"
                              BorderBrush="#45475A" SelectedIndex="1">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="Все вопросы"/>
                    </ComboBox>

                    <!-- Кнопка начала теста -->
                    <Button Content="🚀 Начать тестирование" FontSize="16" FontWeight="Bold"
                            Padding="0,14" Margin="0,25,0,0"
                            Background="#F5C2E7" Foreground="#1E1E2E"
                            BorderThickness="0" Cursor="Hand"
                            Click="StartTest_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Информация о доступных вопросах -->
                    <Border Background="#313244" CornerRadius="8" Padding="15" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="📊 Доступные вопросы:" Foreground="#CDD6F4"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="QuestionStatsText" Foreground="#A6E3A1"
                                       FontSize="13" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Экран вопроса -->
        <Border x:Name="QuestionPanel" Background="Transparent" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- Прогресс -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ProgressText" Text="Вопрос 1 из 10"
                                       Foreground="#CDD6F4" FontSize="16" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,8,20,0"
                                         Background="#313244" Foreground="#F5C2E7"
                                         Minimum="0" Maximum="100" Value="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TimerText" Text="⏱ 00:00"
                                       Foreground="#F9E2AF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="ScoreText" Text="✅ 0  ❌ 0"
                                       Foreground="#6C7086" FontSize="13"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Категория и сложность -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#45475A" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="CategoryText" Text="Категория"
                                       Foreground="#BAC2DE" FontSize="12"/>
                        </Border>
                        <Border x:Name="DifficultyBorder" Background="#45475A"
                                CornerRadius="5" Padding="8,3">
                            <TextBlock x:Name="DifficultyText" Text="⭐"
                                       Foreground="#F9E2AF" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <!-- Текст вопроса -->
                    <Border Background="#313244" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                        <TextBlock x:Name="QuestionText" Text="Текст вопроса..."
                                   Foreground="#CDD6F4" FontSize="16" TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </Border>

                    <!-- Варианты ответов -->
                    <StackPanel x:Name="OptionsPanel">
                        <!-- Заполняется программно -->
                    </StackPanel>

                    <!-- Объяснение (после ответа) -->
                    <Border x:Name="ExplanationPanel" Background="#313244" CornerRadius="10"
                            Padding="15" Margin="0,15,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ExplanationHeader" Text=""
                                       FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ExplanationText" Text=""
                                       Foreground="#BAC2DE" FontSize="14" TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопка "Далее" -->
                    <Button x:Name="NextButton" Content="Следующий вопрос →"
                            FontSize="15" FontWeight="SemiBold"
                            Padding="0,12" Margin="0,15,0,0"
                            Background="#89B4FA" Foreground="#1E1E2E"
                            BorderThickness="0" Cursor="Hand"
                            Visibility="Collapsed"
                            Click="NextQuestion_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Экран результатов -->
        <Border x:Name="ResultPanel" Background="Transparent" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" HorizontalAlignment="Center">
                    <TextBlock Text="🏆 Результаты теста" FontSize="26" FontWeight="Bold"
                               Foreground="#F5C2E7" HorizontalAlignment="Center"
                               Margin="0,20,0,20"/>

                    <!-- Оценка -->
                    <Border Background="#313244" CornerRadius="15" Padding="30" Margin="0,0,0,15"
                            MinWidth="350">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="GradeText" Text="Отлично (5)"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="#A6E3A1" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PercentageText" Text="100%"
                                       FontSize="48" FontWeight="Bold"
                                       Foreground="#CDD6F4" HorizontalAlignment="Center"
                                       Margin="0,5,0,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Детали -->
                    <Border Background="#313244" CornerRadius="10" Padding="20" Margin="0,0,0,15"
                            MinWidth="350">
                        <StackPanel>
                            <TextBlock x:Name="DetailCorrectText" Text="✅ Правильных: 0"
                                       Foreground="#A6E3A1" FontSize="16" Margin="0,3"/>
                            <TextBlock x:Name="DetailWrongText" Text="❌ Неправильных: 0"
                                       Foreground="#F38BA8" FontSize="16" Margin="0,3"/>
                            <TextBlock x:Name="DetailTotalText" Text="📋 Всего вопросов: 0"
                                       Foreground="#CDD6F4" FontSize="16" Margin="0,3"/>
                            <TextBlock x:Name="DetailTimeText" Text="⏱ Время: 00:00"
                                       Foreground="#F9E2AF" FontSize="16" Margin="0,3"/>
                            <TextBlock x:Name="DetailCategoryText" Text="📁 Тема: Все"
                                       Foreground="#BAC2DE" FontSize="16" Margin="0,3"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                        <Button Content="🔄 Пройти заново" FontSize="14" FontWeight="SemiBold"
                                Padding="20,10" Margin="5"
                                Background="#89B4FA" Foreground="#1E1E2E"
                                BorderThickness="0" Cursor="Hand"
                                Click="RetryTest_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="📋 Выбрать другой тест" FontSize="14" FontWeight="SemiBold"
                                Padding="20,10" Margin="5"
                                Background="#A6E3A1" Foreground="#1E1E2E"
                                BorderThickness="0" Cursor="Hand"
                                Click="NewTest_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>