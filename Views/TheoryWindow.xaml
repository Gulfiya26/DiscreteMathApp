<Window x:Class="TipaDiplom.Views.TheoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📚 Теория — Дискретная математика"
        Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню лекций -->
        <Border Grid.Column="0" Background="#181825">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="← Назад к тренажёру"
                        Margin="10,10" Padding="10,8" FontSize="13"
                        Background="#F38BA8" Foreground="#1E1E2E"
                        BorderThickness="0" Cursor="Hand"
                        Click="BackButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,15">
                        <TextBlock Text="📚 Теория" FontSize="22" FontWeight="Bold"
                                   Foreground="#F5C2E7" HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Лекции" FontSize="14"
                                   Foreground="#6C7086" HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <ListBox x:Name="LectureListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="LectureListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#313244" CornerRadius="6"
                                            Padding="10,8" Margin="0,2"
                                            Cursor="Hand">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   Foreground="#CDD6F4"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Основной контент лекции -->
        <Border Grid.Column="1" Margin="10" Background="#181825" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
                <StackPanel>
                    <TextBlock x:Name="LectureTitle"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#F5C2E7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="LectureContent"
                               Foreground="#CDD6F4" FontSize="15"
                               TextWrapping="Wrap" LineHeight="26"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>