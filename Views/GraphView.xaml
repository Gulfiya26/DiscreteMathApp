<UserControl x:Class="TipaDiplom.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="🕸️ Теория графов" FontSize="24" FontWeight="Bold" 
                       Foreground="#CBA6F7" Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Количество вершин:" Foreground="#CDD6F4" FontSize="14"/>
                    <TextBox x:Name="VertexCountInput" Text="5" Margin="0,5"/>

                    <CheckBox x:Name="IsDirectedCheckBox" Content="Ориентированный граф" 
                              Foreground="#CDD6F4" Margin="0,5" FontSize="13"/>

                    <Button Content="Создать граф" Click="CreateGraph_Click" 
                            Background="#A6E3A1" Margin="0,10"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Добавить ребро (откуда куда вес):" Foreground="#CDD6F4" FontSize="14"/>
                    <TextBox x:Name="EdgeInput" Text="0 1 1" Margin="0,5"/>
                    <WrapPanel>
                        <Button Content="Добавить ребро" Click="AddEdge_Click"/>
                        <Button Content="Удалить ребро" Click="RemoveEdge_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,15,0,5">
                <Button Content="Матрица смежности" Click="AdjMatrix_Click"/>
                <Button Content="Список смежности" Click="AdjList_Click"/>
                <Button Content="Матрица инцидентности" Click="IncMatrix_Click"/>
                <Button Content="Степени вершин" Click="Degrees_Click"/>
                <Button Content="BFS" Click="BFS_Click"/>
                <Button Content="DFS" Click="DFS_Click"/>
                <Button Content="Дейкстра" Click="Dijkstra_Click"/>
                <Button Content="Флойд-Уоршелл" Click="Floyd_Click"/>
                <Button Content="Краскал (MST)" Click="Kruskal_Click"/>
                <Button Content="Эйлеров путь?" Click="Euler_Click"/>
                <Button Content="Раскраска" Click="Coloring_Click"/>
                <Button Content="Связность" Click="Connectivity_Click"/>
                <Button Content="Транз. замыкание" Click="TransitiveClosure_Click"/>
            </WrapPanel>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                    <TextBlock x:Name="ResultText" Text="Создайте граф..." 
                               Foreground="#A6E3A1" FontSize="13" TextWrapping="Wrap"
                               FontFamily="Consolas"/>
                </Border>

                <Border Grid.Column="1" Background="#313244" CornerRadius="8" Padding="10">
                    <Canvas x:Name="GraphCanvas" Width="280" Height="280" 
                            Background="Transparent"/>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>