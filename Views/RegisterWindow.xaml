<Window x:Class="TipaDiplom.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация — Дискретная математика" 
        Height="680" Width="696"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Grid>
        <Border Background="#181825" CornerRadius="15" Margin="20" Padding="30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">

                    <!-- Заголовок -->
                    <TextBlock Text="📐" FontSize="40" HorizontalAlignment="Center" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold"
                               Foreground="#89B4FA" HorizontalAlignment="Center" 
                               Margin="0,0,0,20"/>

                    <!-- Имя пользователя -->
                    <TextBlock Text="Имя пользователя *" Foreground="#BAC2DE" 
                               FontSize="13" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameBox" FontSize="14" Padding="10,8"
                             Background="#313244" Foreground="#CDD6F4" 
                             BorderBrush="#45475A" BorderThickness="1"
                             MaxLength="50">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Email -->
                    <TextBlock Text="Email *" Foreground="#BAC2DE" FontSize="13" 
                               Margin="0,12,0,5"/>
                    <TextBox x:Name="EmailBox" FontSize="14" Padding="10,8"
                             Background="#313244" Foreground="#CDD6F4" 
                             BorderBrush="#45475A" BorderThickness="1"
                             MaxLength="100">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Имя -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Имя" Foreground="#BAC2DE" FontSize="13" 
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="FirstNameBox" FontSize="14" Padding="10,8"
                                     Background="#313244" Foreground="#CDD6F4" 
                                     BorderBrush="#45475A" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Фамилия" Foreground="#BAC2DE" FontSize="13" 
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="LastNameBox" FontSize="14" Padding="10,8"
                                     Background="#313244" Foreground="#CDD6F4" 
                                     BorderBrush="#45475A" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль *" Foreground="#BAC2DE" FontSize="13" 
                               Margin="0,12,0,5"/>
                    <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8"
                                 Background="#313244" Foreground="#CDD6F4" 
                                 BorderBrush="#45475A" BorderThickness="1"
                                 MaxLength="50">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <TextBlock Text="Минимум 6 символов, заглавная, строчная буква и цифра" 
                               Foreground="#6C7086" FontSize="11" Margin="0,3,0,0"/>

                    <!-- Подтверждение пароля -->
                    <TextBlock Text="Подтверждение пароля *" Foreground="#BAC2DE" 
                               FontSize="13" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" FontSize="14" Padding="10,8"
                                 Background="#313244" Foreground="#CDD6F4" 
                                 BorderBrush="#45475A" BorderThickness="1"
                                 MaxLength="50">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <!-- Сообщение -->
                    <TextBlock x:Name="MessageText" Text="" FontSize="12" 
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="Collapsed"/>

                    <!-- Кнопка регистрации -->
                    <Button Content="Зарегистрироваться" FontSize="16" FontWeight="Bold"
                            Padding="0,12" Margin="0,18,0,10"
                            Background="#89B4FA" Foreground="#1E1E2E"
                            BorderThickness="0" Cursor="Hand"
                            Click="Register_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Ссылка на вход -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Уже есть аккаунт? " Foreground="#6C7086" 
                                   FontSize="13"/>
                        <TextBlock Text="Войдите" Foreground="#CBA6F7" FontSize="13"
                                   Cursor="Hand" TextDecorations="Underline"
                                   MouseLeftButtonDown="GoToLogin_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>