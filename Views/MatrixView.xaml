<UserControl x:Class="TipaDiplom.Views.MatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FAB387"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="📊 Операции с матрицами" FontSize="24" FontWeight="Bold" 
                       Foreground="#FAB387" Margin="0,0,0,15"/>

            <TextBlock Foreground="#BAC2DE" FontSize="12" Margin="0,0,0,10">
                Вводите матрицы: каждая строка на новой строке, элементы через пробел
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Матрица A:" Foreground="#CDD6F4" FontSize="14"/>
                    <TextBox x:Name="MatrixAInput" Height="120" 
                             Text="1 2 3&#x0a;4 5 6&#x0a;7 8 9"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Матрица B:" Foreground="#CDD6F4" FontSize="14"/>
                    <TextBox x:Name="MatrixBInput" Height="120" 
                             Text="9 8 7&#x0a;6 5 4&#x0a;3 2 1"/>
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,15,0,10">
                <Button Content="A + B" Click="Add_Click"/>
                <Button Content="A × B" Click="Multiply_Click"/>
                <Button Content="Aᵀ (Транспонирование)" Click="Transpose_Click"/>
                <Button Content="A² (Степень)" Click="Power_Click"/>
                <Button Content="det(A)" Click="Determinant_Click"/>
                <Button Content="Булево A∨B" Click="BooleanAdd_Click"/>
                <Button Content="Булево A∧B" Click="BooleanMultiply_Click"/>
                <Button Content="Транз. замыкание" Click="TransClosure_Click"/>
            </WrapPanel>

            <Border Background="#313244" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                <TextBlock x:Name="ResultText" Text="Результат появится здесь..." 
                           Foreground="#A6E3A1" FontSize="14" TextWrapping="Wrap"
                           FontFamily="Consolas"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>