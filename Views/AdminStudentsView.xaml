<UserControl x:Class="TipaDiplom.Views.AdminStudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="👥 Список студентов" FontSize="24"
                       FontWeight="Bold" Foreground="#A6E3A1"/>
            <TextBlock x:Name="CountText" Foreground="#6C7086" FontSize="13"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#313244" CornerRadius="8">
            <DataGrid x:Name="StudentsGrid"
                      Background="Transparent" Foreground="#CDD6F4"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#45475A"
                      RowBackground="#313244"
                      AlternatingRowBackground="#2A2A3E"
                      ColumnHeaderHeight="40" RowHeight="35"
                      AutoGenerateColumns="False"
                      IsReadOnly="True" FontSize="13">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#45475A"/>
                        <Setter Property="Foreground" Value="#A6E3A1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Студент" 
                                        Binding="{Binding DisplayName}" Width="150"/>
                    <DataGridTextColumn Header="Логин" 
                                        Binding="{Binding Username}" Width="100"/>
                    <DataGridTextColumn Header="Email" 
                                        Binding="{Binding Email}" Width="180"/>
                    <DataGridTextColumn Header="Тестов пройдено" 
                                        Binding="{Binding TotalTests}" Width="130"/>
                    <DataGridTextColumn Header="Последняя активность" 
                                        Binding="{Binding LastActivity, 
                                        StringFormat=dd.MM.yyyy HH:mm}" Width="170"/>
                    <DataGridTextColumn Header="Дата регистрации" 
                                        Binding="{Binding RegisteredAt, 
                                        StringFormat=dd.MM.yyyy}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>