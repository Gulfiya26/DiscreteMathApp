<UserControl x:Class="TipaDiplom.Views.NumberSystemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#94E2D5"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="🔄 Системы счисления" FontSize="24" FontWeight="Bold" 
                       Foreground="#94E2D5" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Число:" Foreground="#CDD6F4" FontSize="14" 
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="NumberInput" Text="255" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Из основания:" Foreground="#CDD6F4" FontSize="14" 
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="FromBaseInput" Text="10" Width="60"/>
                <TextBlock Text="В основание:" Foreground="#CDD6F4" FontSize="14" 
                           VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox x:Name="ToBaseInput" Text="2" Width="60"/>
            </StackPanel>

            <WrapPanel Margin="0,10">
                <Button Content="Конвертировать" Click="Convert_Click"/>
                <Button Content="Во все системы" Click="ConvertAll_Click"/>
            </WrapPanel>

            <Border Background="#313244" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                <TextBlock x:Name="ResultText" Text="Результат появится здесь..." 
                           Foreground="#A6E3A1" FontSize="14" TextWrapping="Wrap"
                           FontFamily="Consolas"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>