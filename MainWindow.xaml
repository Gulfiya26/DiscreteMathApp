<Window x:Class="TipaDiplom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дискретная математика" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="#181825">
            <DockPanel>
                <!-- Панель пользователя внизу -->
                <Border DockPanel.Dock="Bottom" Background="#11111B" Padding="10" Margin="5">
                    <StackPanel>
                        <Separator Background="#45475A" Margin="0,10"/>

                        <Button Content="📝 Тестирование" Style="{StaticResource MenuButtonStyle}"
        Click="ShowTesting"/>
                        <Button Content="📚 Теория" Style="{StaticResource MenuButtonStyle}"
        Click="ShowTheory" Background="#45475A"/>
                        <TextBlock x:Name="UserNameText" Text="Пользователь" 
                                   Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UserEmailText" Text="email" 
                                   Foreground="#6C7086" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Content="🚪 Выйти" Margin="0,8,0,0"
                                Background="#F38BA8" Foreground="#1E1E2E"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="8,5" BorderThickness="0" Cursor="Hand"
                                Click="Logout_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Меню навигации -->
                <StackPanel Margin="10,20,10,10">
                    <TextBlock Text="📐 Дискретная" FontSize="20" FontWeight="Bold" 
                               Foreground="#CBA6F7" HorizontalAlignment="Center"/>
                    <TextBlock Text="математика" FontSize="20" FontWeight="Bold" 
                               Foreground="#CBA6F7" HorizontalAlignment="Center" 
                               Margin="0,0,0,20"/>

                    <Button Content="🔢 Множества" Style="{StaticResource MenuButtonStyle}" 
                            Click="ShowSetOperations"/>
                    <Button Content="⚡ Булева алгебра" Style="{StaticResource MenuButtonStyle}" 
                            Click="ShowBooleanAlgebra"/>
                    <Button Content="🕸️ Теория графов" Style="{StaticResource MenuButtonStyle}" 
                            Click="ShowGraphTheory"/>
                    <Button Content="🎲 Комбинаторика" Style="{StaticResource MenuButtonStyle}" 
                            Click="ShowCombinatorics"/>
                    <Button Content="📊 Матрицы" Style="{StaticResource MenuButtonStyle}" 
                            Click="ShowMatrix"/>
                    <Button Content="🔄 Системы счисления" Style="{StaticResource MenuButtonStyle}" 
                            Click="ShowNumberSystems"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Column="1" Margin="10" Background="#181825" CornerRadius="12">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>